# Same-origin HTTPS proxy: leave these empty on laptop and phone.
VITE_API_URL=
VITE_WS_URL=

VITE_ROUTING_API_URL=https://router.project-osrm.org

# Address Geocoding & Autocomplete (Photon / OpenStreetMap)
# Free, open-source typeahead geocoder by Komoot. No API key required by default.
VITE_GEOCODING_SEARCH_URL=https://photon.komoot.io/api/
VITE_GEOCODING_REVERSE_URL=https://photon.komoot.io/reverse
VITE_GEOCODING_API_KEY=
